# Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secrets
GOOGLE_GEMINI_API=
INTERNAL_API_SECRET=

# OpenRouter management key — enables the top-right credit-balance widget.
# Optional: if unset, the widget hides and the app still boots.
OPENROUTER_MANAGEMENT_KEY=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
